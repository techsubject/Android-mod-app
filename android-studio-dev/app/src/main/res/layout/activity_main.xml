<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFBE7"
    tools:context=".MainActivity">

    <!-- HEADER -->

    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/black"
        android:gravity="center"
        android:text="Buy mods for games"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/loginButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="Login"
        android:clickable="true"
        android:focusable="true"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/login_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/headerTitle"
        app:layout_constraintBottom_toBottomOf="@id/headerTitle" />

    <EditText
        android:id="@+id/searchEditText"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="8dp"
        android:background="@color/newsearch"
        android:hint="What mod are we looking for today?"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#000000"
        android:textColorHint="#777777"
        app:layout_constraintTop_toBottomOf="@id/headerTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- MOD 1: GTA V -->

    <ImageView
        android:id="@+id/homeButton"
        android:layout_width="30dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:contentDescription="Home"
        android:focusable="true"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toTopOf="@+id/searchEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/_049_13551_removebg_preview" />

    <ImageView
        android:id="@+id/imageGtaV"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/image3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/buttonGtaV"
        app:layout_constraintTop_toTopOf="@id/buttonGtaV"
        app:layout_constraintBottom_toBottomOf="@id/buttonGtaV" />

    <Button
        android:id="@+id/buttonGtaV"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="#D9D9D9"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="65dp"
        android:text="More and better cars | GTA V"
        android:textColor="#000000"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/searchEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/priceGtaV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="#4CAF50"
        android:padding="5dp"
        android:text="€4,99"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/buttonGtaV"
        app:layout_constraintTop_toTopOf="@id/buttonGtaV"
        app:layout_constraintBottom_toBottomOf="@id/buttonGtaV" />

    <!-- MOD 2: F1 PACK -->

    <ImageView
        android:id="@+id/imageF1Pack"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/image_11"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/buttonF1Pack"
        app:layout_constraintTop_toTopOf="@id/buttonF1Pack"
        app:layout_constraintBottom_toBottomOf="@id/buttonF1Pack" />

    <Button
        android:id="@+id/buttonF1Pack"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="#D9D9D9"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="65dp"
        android:text="Formula 1 2026 car pack | BeamNG.drive"
        android:textColor="#000000"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/buttonGtaV"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/priceF1Pack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="#4CAF50"
        android:padding="5dp"
        android:text="FREE"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/buttonF1Pack"
        app:layout_constraintTop_toTopOf="@id/buttonF1Pack"
        app:layout_constraintBottom_toBottomOf="@id/buttonF1Pack" />

    <!-- MOD 3: MEGA HACK -->

    <ImageView
        android:id="@+id/imageMegaHack"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/image_5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/buttonMegaHack"
        app:layout_constraintTop_toTopOf="@id/buttonMegaHack"
        app:layout_constraintBottom_toBottomOf="@id/buttonMegaHack" />

    <Button
        android:id="@+id/buttonMegaHack"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="#D9D9D9"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="65dp"
        android:text="Megahack | Geometry Dash"
        android:textColor="#000000"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/buttonF1Pack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/priceMegaHack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="#4CAF50"
        android:padding="5dp"
        android:text="€2,99"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/buttonMegaHack"
        app:layout_constraintTop_toTopOf="@id/buttonMegaHack"
        app:layout_constraintBottom_toBottomOf="@id/buttonMegaHack" />

    <!-- MOD 4: GEODE -->

    <ImageView
        android:id="@+id/imageGeode"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/image_7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/buttonGeode"
        app:layout_constraintTop_toTopOf="@id/buttonGeode"
        app:layout_constraintBottom_toBottomOf="@id/buttonGeode" />

    <Button
        android:id="@+id/buttonGeode"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="#D9D9D9"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="65dp"
        android:text="Geode mod loader | Geometry Dash"
        android:textColor="#000000"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/buttonMegaHack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/priceGeode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="#4CAF50"
        android:padding="5dp"
        android:text="FREE"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/buttonGeode"
        app:layout_constraintTop_toTopOf="@id/buttonGeode"
        app:layout_constraintBottom_toBottomOf="@id/buttonGeode" />

    <!-- MOD 5: CARBONWORKS -->

    <ImageView
        android:id="@+id/imageCarbonworks"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/image_11"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/buttonCarbonworks"
        app:layout_constraintTop_toTopOf="@id/buttonCarbonworks"
        app:layout_constraintBottom_toBottomOf="@id/buttonCarbonworks" />

    <Button
        android:id="@+id/buttonCarbonworks"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="#D9D9D9"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="65dp"
        android:text="Carbonworks F4 | BeamNG.drive"
        android:textColor="#000000"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/buttonGeode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/priceCarbonworks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="#4CAF50"
        android:padding="5dp"
        android:text="FREE"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/buttonCarbonworks"
        app:layout_constraintTop_toTopOf="@id/buttonCarbonworks"
        app:layout_constraintBottom_toBottomOf="@id/buttonCarbonworks" />

</androidx.constraintlayout.widget.ConstraintLayout>
