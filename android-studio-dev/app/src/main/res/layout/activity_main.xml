<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFBE7"
    tools:context=".MainActivity2">

    <!-- HEADER -->

    <EditText
        android:id="@+id/textInputEditText2"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginStart="2dp"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="10dp"
        android:background="@color/newsearch"
        android:hint="What mod are we looking for today?"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#000000"
        android:textColorHint="#777777"
        app:layout_constraintBottom_toTopOf="@+id/bettercarsgtav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mainbar" />

    <TextView
        android:id="@+id/mainbar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/black"
        android:gravity="center"
        android:inputType="text"
        android:text="Buy mods for games"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/editTextText"
        app:layout_constraintBottom_toBottomOf="@id/editTextText"
        app:srcCompat="@drawable/_049_13551_removebg_preview" />

    <!-- SEARCH -->

    <EditText
        android:id="@+id/textInputEditText"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginStart="2dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="2dp"
        android:background="@color/newsearch"
        android:hint="What mod are we looking for today?"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#000000"
        android:textColorHint="#777777"
        app:layout_constraintBottom_toTopOf="@+id/mainbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editTextText" />


    <!-- ================= MOD 1 ================= -->

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@id/bettercarsgtav"
        app:layout_constraintEnd_toStartOf="@+id/bettercarsgtav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/bettercarsgtav"
        app:srcCompat="@drawable/image3" />

    <Button
        android:id="@+id/bettercarsgtav"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="112dp"
        android:layout_marginEnd="6dp"
        android:backgroundTint="#D9D9D9"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="65dp"
        android:text="More and better cars | GTA V"
        android:textColor="#000000"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textInputEditText" />

    <TextView
        android:id="@+id/price1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="#4CAF50"
        android:padding="5dp"
        android:text="€4,99"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/bettercarsgtav"
        app:layout_constraintTop_toTopOf="@id/bettercarsgtav"
        app:layout_constraintBottom_toBottomOf="@id/bettercarsgtav" />


    <!-- ================= MOD 2 ================= -->

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toTopOf="@+id/imageView3"
        app:layout_constraintEnd_toStartOf="@+id/f1carpackbutton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView"
        app:srcCompat="@drawable/image_11" />

    <Button
        android:id="@+id/f1carpackbutton"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="6dp"
        android:backgroundTint="#D9D9D9"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="65dp"
        android:text="Formula 1 2026 car pack | BeamNG.drive"
        android:textColor="#000000"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/bettercarsgtav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/price2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="#4CAF50"
        android:padding="5dp"
        android:text="FREE"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/f1carpackbutton"
        app:layout_constraintTop_toTopOf="@id/f1carpackbutton"
        app:layout_constraintBottom_toBottomOf="@id/f1carpackbutton" />


    <!-- ================= MOD 3 ================= -->

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@id/megahack"
        app:layout_constraintEnd_toStartOf="@+id/megahack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/megahack"
        app:srcCompat="@drawable/image_5" />

    <Button
        android:id="@+id/megahack"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="6dp"
        android:backgroundTint="#D9D9D9"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="65dp"
        android:text="Megahack | Geometry Dash"
        android:textColor="#000000"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/f1carpackbutton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/price3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="#4CAF50"
        android:padding="5dp"
        android:text="€2,99"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/megahack"
        app:layout_constraintTop_toTopOf="@id/megahack"
        app:layout_constraintBottom_toBottomOf="@id/megahack" />


    <!-- ================= MOD 4 ================= -->

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@id/button4"
        app:layout_constraintEnd_toStartOf="@+id/button4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/button4"
        app:srcCompat="@drawable/image_7" />

    <Button
        android:id="@+id/button4"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="6dp"
        android:backgroundTint="#D9D9D9"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="65dp"
        android:text="Geode mod loader | Geometry Dash"
        android:textColor="#000000"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/megahack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/price4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="#4CAF50"
        android:padding="5dp"
        android:text="FREE"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/button4"
        app:layout_constraintTop_toTopOf="@id/button4"
        app:layout_constraintBottom_toBottomOf="@id/button4" />


    <!-- ================= MOD 5 ================= -->

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@id/carbonworksf4"
        app:layout_constraintEnd_toStartOf="@+id/carbonworksf4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/carbonworksf4"
        app:layout_constraintVertical_bias="0.263"
        app:srcCompat="@drawable/image_11" />

    <Button
        android:id="@+id/carbonworksf4"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="6dp"
        android:backgroundTint="#D9D9D9"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="65dp"
        android:text="Carbonworks F4 | BeamNG.drive"
        android:textColor="#000000"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/button4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/price5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="#4CAF50"
        android:padding="5dp"
        android:text="FREE"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/carbonworksf4"
        app:layout_constraintTop_toTopOf="@id/carbonworksf4"
        app:layout_constraintBottom_toBottomOf="@id/carbonworksf4" />

</androidx.constraintlayout.widget.ConstraintLayout>
